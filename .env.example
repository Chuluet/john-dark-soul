# PostgreSQL + pgvector
POSTGRES_USER=darksoul
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=darksoul
DATABASE_URL=postgresql+psycopg://darksoul:cambiar_esta_clave@localhost:5432/darksoul
PG_COLLECTION=darksouls

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
TEMPERATURE=0.1

# Ingesta
DOCS_PATH=data/wiki
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# RAG
RETRIEVER_K=5
SIMILARITY_THRESHOLD=0.46
RETRIEVER_FETCH_K=40
RETRIEVER_MAX_POR_FUENTE=1

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_esta_clave
# URL pública (la del navegador y la del claim `iss` del token)
KEYCLOAK_URL=http://localhost:8080
# URL desde la que el backend descarga el JWKS (en Docker el compose usa http://keycloak:8080)
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=john-dark-soul
KEYCLOAK_CLIENT_ID=frontend

# API
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
