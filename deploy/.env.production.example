# .env del servidor (EC2). Copiar a la raíz del repo como `.env`:
#
#   cp deploy/.env.production.example .env && nano .env
#
# Reemplazar 1-2-3-4 por la Elastic IP con guiones (3.85.10.20 -> 3-85-10-20),
# la URL de Netlify y TODAS las contraseñas. Este archivo no se sube a git.

# --- Dominios públicos (sslip.io resuelve api.1-2-3-4.sslip.io a 1.2.3.4) ----
API_DOMAIN=api.1-2-3-4.sslip.io
AUTH_DOMAIN=auth.1-2-3-4.sslip.io
# URL de Netlify, sin "/" al final. De aquí sale el CORS del backend y la
# redirección permitida en Keycloak (deploy/configurar_keycloak.sh).
FRONTEND_URL=https://john-dark-soul.netlify.app

# --- PostgreSQL + pgvector -----------------------------------------------------
POSTGRES_USER=darksoul
POSTGRES_PASSWORD=cambiar_por_una_clave_larga
POSTGRES_DB=darksoul
# El compose la reemplaza por el host interno `db`; queda por coherencia.
DATABASE_URL=postgresql+psycopg://darksoul:cambiar_por_una_clave_larga@db:5432/darksoul
PG_COLLECTION=darksouls

# --- Ollama (CPU) --------------------------------------------------------------
# qwen2.5:3b: en CPU el de 7b tarda demasiado por respuesta. Descargarlo con
# `ollama pull` después del primer `up` (ver docs/DESPLIEGUE.md).
LLM_MODEL=qwen2.5:3b
# Debe ser el mismo modelo con el que se generó backend/data/embeddings.dump.
EMBED_MODEL=bge-m3
TEMPERATURE=0.1
VISION_MODEL=qwen2.5vl:3b
WHISPER_MODEL=small

# --- Ingesta y RAG -------------------------------------------------------------
DOCS_PATH=data/wiki
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=100
RETRIEVER_K=5
SIMILARITY_THRESHOLD=0.46
SIMILARITY_FLOOR=0.38
RETRIEVER_FETCH_K=40
RETRIEVER_MAX_POR_FUENTE=1

# --- Keycloak --------------------------------------------------------------------
# Admin de la consola (https://AUTH_DOMAIN/admin). Solo se usa al crear la base
# de Keycloak por primera vez: cambiarla después se hace desde la consola.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_por_una_clave_larga
KEYCLOAK_REALM=john-dark-soul
KEYCLOAK_CLIENT_ID=frontend
# El compose de producción fija KEYCLOAK_URL=https://AUTH_DOMAIN y
# CORS_ORIGINS=FRONTEND_URL en el backend; no hace falta repetirlas aquí.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
