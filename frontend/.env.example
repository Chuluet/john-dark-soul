# Copia este archivo como .env.local y ajusta los valores.

# URL del backend (FastAPI)
VITE_API_URL=http://localhost:8000

# Keycloak (mismos valores que el realm de keycloak/realm-john-dark-soul.json)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=john-dark-soul
VITE_KEYCLOAK_CLIENT_ID=frontend

# true: no usa Keycloak ni el backend, todo con datos de ejemplo (sirve para
# ver la interfaz mientras no existen los endpoints).
VITE_USE_MOCKS=false
